{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proyectolibero.org/schemas/release.schema.json",
  "title": "Manifiesto de release",
  "type": "object",
  "required": ["schemaVersion", "releaseId", "asOf", "created", "contents", "checksum", "dataset", "license"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "releaseId": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}(-[a-z0-9]+)?$" },
    "asOf": { "type": "string", "format": "date" },
    "created": { "type": "string", "format": "date-time" },
    "generatedBy": { "type": "string" },
    "contents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "schemaVersion"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "schemaVersion": { "type": "integer" },
          "archetype": { "enum": ["encounter", "ranking", "timed", "scored"] },
          "edition": { "type": ["integer", "string"] }
        }
      }
    },
    "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dataset": {
      "type": "object",
      "required": ["sports", "competitions", "editions"],
      "additionalProperties": true,
      "properties": {
        "sports": { "type": "integer", "minimum": 0 },
        "competitions": { "type": "integer", "minimum": 0 },
        "editions": { "type": "integer", "minimum": 0 }
      }
    },
    "license": {
      "type": "object",
      "required": ["layers", "commercialResale", "attribution"],
      "additionalProperties": false,
      "properties": {
        "layers": { "type": "string" },
        "commercialResale": { "const": false },
        "attribution": {
          "type": "array",
          "items": { "$ref": "#/$defs/attributionEntry" }
        },
        "referenceOnly": {
          "type": "array",
          "items": { "$ref": "#/$defs/attributionEntry" }
        }
      }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "attributionEntry": {
      "type": "object",
      "required": ["source", "name", "url", "retrieved"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "retrieved": { "type": "string", "format": "date" },
        "author": { "type": "string" }
      }
    }
  }
}
