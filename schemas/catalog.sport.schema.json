{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proyectolibero.org/schemas/catalog.sport.schema.json",
  "title": "Catálogo de deportes",
  "type": "object",
  "required": ["schemaVersion", "sports"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "updatedAt": { "type": "string", "format": "date" },
    "description": { "type": "string" },
    "sports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "slug", "name", "i18nKey", "resultArchetypes", "status", "competitions"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "i18nKey": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9.]*$" },
          "resultArchetypes": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["encounter", "ranking", "timed", "scored"] }
          },
          "status": { "enum": ["active", "planned", "deprecated"] },
          "competitions": { "type": "integer", "minimum": 0 },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
